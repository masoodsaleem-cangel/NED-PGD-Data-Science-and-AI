# Prefer the user's SDK. A runtime-only WinGet install has no C headers. Its
# ABI must match the bundled header snapshot exactly.
if(LLAMA_ROOT)
    set(roots "${LLAMA_ROOT}")
else()
    set(roots "$ENV{ProgramFiles}/llama.cpp")
    file(GLOB winget_roots "$ENV{LOCALAPPDATA}/Microsoft/WinGet/Packages/ggml.llamacpp_*")
    list(APPEND roots ${winget_roots})
endif()
set(search_roots)
foreach(root IN LISTS roots)
    list(APPEND search_roots "${root}")
    file(GLOB subdirs LIST_DIRECTORIES true "${root}/llama*")
    foreach(dir IN LISTS subdirs)
        if(IS_DIRECTORY "${dir}")
            list(APPEND search_roots "${dir}")
        endif()
    endforeach()
endforeach()
foreach(root IN LISTS search_roots)
    file(TO_CMAKE_PATH "${root}" root)
    unset(dll_dir)
    foreach(leaf IN ITEMS bin bin/x64 bin/Release lib .)
        if(EXISTS "${root}/${leaf}/llama.dll")
            set(dll_dir "${root}/${leaf}")
            break()
        endif()
    endforeach()
    if(NOT dll_dir)
        continue()
    endif()
    unset(LLAMA_INCLUDE)
    foreach(leaf IN ITEMS include include/llama .)
        if(EXISTS "${root}/${leaf}/llama.h")
            set(LLAMA_INCLUDE "${root}/${leaf}")
            break()
        endif()
    endforeach()
    if(NOT LLAMA_INCLUDE)
        if(NOT EXISTS "${dll_dir}/llama-cli.exe")
            message(FATAL_ERROR "A runtime-only directory requires llama-cli.exe for an ABI check. Supply a matching development SDK using LLAMA_ROOT.")
        endif()
        execute_process(COMMAND "${dll_dir}/llama-cli.exe" --version
            OUTPUT_VARIABLE ver ERROR_VARIABLE err TIMEOUT 20)
        if(NOT "${ver} ${err}" MATCHES "(427291b5b|build 10816[^0-9])")
            message(FATAL_ERROR "Runtime-only builds use b10816 (427291b5b). For another build, set LLAMA_ROOT to its matching SDK.")
        endif()
        set(LLAMA_INCLUDE "${CMAKE_CURRENT_SOURCE_DIR}/vendor/llama-b10816/include")
    endif()
    foreach(extra IN ITEMS "${root}/include" "${root}/include/ggml" "${root}/ggml/include")
        if(IS_DIRECTORY "${extra}")
            list(APPEND LLAMA_INCLUDE "${extra}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES LLAMA_INCLUDE)
    file(GLOB LLAMA_LIBRARIES CONFIGURE_DEPENDS "${root}/lib/*.lib" "${root}/lib/x64/*.lib"
        "${root}/lib/Release/*.lib" "${root}/*.lib")
    file(GLOB LLAMA_DLLS CONFIGURE_DEPENDS "${dll_dir}/*.dll")
    if(NOT LLAMA_LIBRARIES)
        if(MINGW)
            set(LLAMA_LIBRARIES "${dll_dir}/llama.dll" "${dll_dir}/ggml.dll" "${dll_dir}/ggml-base.dll")
        elseif(MSVC)
            # Generate import libraries from the actual DLL export tables.
            get_filename_component(link_bin "${CMAKE_LINKER}" DIRECTORY)
            find_program(DUMPBIN_EXE dumpbin HINTS "${link_bin}" REQUIRED)
            find_program(LIB_EXE lib HINTS "${link_bin}" REQUIRED)
            foreach(name IN ITEMS llama ggml ggml-base)
                execute_process(COMMAND "${DUMPBIN_EXE}" /nologo /exports "${dll_dir}/${name}.dll"
                    OUTPUT_VARIABLE symbols COMMAND_ERROR_IS_FATAL ANY)
                string(REGEX MATCHALL "[\r\n]+[ \t]+[0-9]+[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+[A-Za-z_][A-Za-z0-9_]*" rows "${symbols}")
                set(def "LIBRARY ${name}.dll\nEXPORTS\n")
                foreach(row IN LISTS rows)
                    string(REGEX MATCH "[A-Za-z_][A-Za-z0-9_]*$" sym "${row}")
                    string(APPEND def "${sym}\n")
                endforeach()
                file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${name}.def" "${def}")
                set(lib "${CMAKE_CURRENT_BINARY_DIR}/${name}-import.lib")
                execute_process(COMMAND "${LIB_EXE}" /nologo /machine:x64 "/def:${CMAKE_CURRENT_BINARY_DIR}/${name}.def" "/out:${lib}" COMMAND_ERROR_IS_FATAL ANY)
                list(APPEND LLAMA_LIBRARIES "${lib}")
            endforeach()
        endif()
    endif()
    message(STATUS "llama.cpp includes: ${LLAMA_INCLUDE}")
    message(STATUS "llama.cpp DLL directory: ${dll_dir}")
    break()
endforeach()
if(NOT LLAMA_LIBRARIES OR NOT LLAMA_DLLS)
    message(FATAL_ERROR "Set -DLLAMA_ROOT=C:/path/to/llama.cpp, or use -DTOKENSCOPE_CAPTURE=OFF to build replay only.")
endif()
